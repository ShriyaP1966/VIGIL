# VIGIL Environment Configuration Template
# Copy this file to .env for local overrides (never commit .env)

# Application mode: offline (default, no keys needed) | local | cloud
APP_MODE=offline

# Optional: Gemini API key for Cloud-assisted extractor (free tier from Google AI Studio)
# Leave blank for deterministic offline mode (RuleMLExtractor)
GEMINI_API_KEY=

# Optional: Gemini model name (read from current documentation, e.g., gemini-1.5-flash or gemini-2.0-flash)
# Must not be hardcoded in code
GEMINI_MODEL=

# Database configuration: SQLite local file
DATABASE_URL=sqlite:///./vigil.db

# Candidate association similarity threshold for playbook fingerprinting (default 0.75)
T_CANDIDATE=0.75

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
